# Copy to .env and fill in. Never commit the real file.

# Server
# PORT=9736
# NAME=My BetterCrewLink Server
# Leave HTTPS unset behind a reverse proxy (Traefik/nginx/Caddy) -- the proxy terminates TLS.
# HTTPS=
# SSLPATH=
# Only used by the integrated TURN relay. Docker sets HOSTNAME to the container ID automatically,
# which is not a routable address -- set it explicitly if you enable the relay.
# HOSTNAME=

# Managed TURN (Cloudflare Realtime). Leave integratedRelay.enabled=false when using this.
# Create a key at: Cloudflare dashboard -> Realtime -> TURN
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Credential lifetime. Cloudflare caps this at 172800 (48h); values are clamped.
# CF_TURN_TTL_SECONDS=86400

# Force every voice connection through the TURN relay instead of connecting players
# directly. Use it to prove TURN works, or leave it on to keep players' IP addresses
# hidden from each other -- at the cost of relay bandwidth and a little latency.
# FORCE_RELAY_ONLY=false

# Grace period before an orphaned public lobby is dropped from the browser.
# Lobbies that still have players in them are never evicted.
# LOBBY_TTL_MINUTES=15
