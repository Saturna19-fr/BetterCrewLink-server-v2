# Copy to .env and fill in. Never commit the real file.

# Server
# PORT=9736
# NAME=My BetterCrewLink Server
# HTTPS=
# SSLPATH=
# HOSTNAME=            # only needed when integratedRelay is enabled

# Managed TURN (Cloudflare Realtime). Leave integratedRelay.enabled=false when using this.
# Create a key at: Cloudflare dashboard -> Realtime -> TURN
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# CF_TURN_TTL_SECONDS=86400

# How long a public lobby stays listed after its host stops advertising it.
# LOBBY_TTL_MINUTES=15
